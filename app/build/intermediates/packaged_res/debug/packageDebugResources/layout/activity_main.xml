<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bubble_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== Top app bar (unchanged) ===== -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/bubble_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_card_12"
                android:padding="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/premium_movie_link_logo_1790163614766" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/title_brand"
                    android:textColor="@color/bubble_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/title_brand_sub"
                    android:textColor="@color/bubble_text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_help"
                style="@style/IconButton"
                android:text="help_outline" />

            <TextView
                android:id="@+id/btn_add"
                style="@style/IconButton"
                android:text="add_circle" />

            <TextView
                android:id="@+id/btn_options"
                style="@style/IconButton"
                android:text="more_vert"
                android:textColor="@color/bubble_text_secondary" />
        </LinearLayout>

        <!-- Secondary file import bar progress indicator -->
        <ProgressBar
            android:id="@+id/import_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/bubble_blue"
            android:visibility="gone" />

        <!-- ===== Tab content host ===== -->
        <FrameLayout
            android:id="@+id/content_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ===== Bottom Tab Navigation Bar =====
         Final layout (6 tabs):
           0 Dashboard      - new search page (screenshot 1)
           1 Sync Hub       - existing cloud-sync page
           2 Setup          - current dashboard page (scheduler + mini console)
           3 Categories     - scheduler categories moved out of Setup
           4 Config         - existing credentials/advanced page
           5 Console        - full scheduler log page -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_dashboard"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_dashboard_icon"
                style="@style/BottomTabIcon"
                android:text="search" />

            <TextView
                android:id="@+id/tab_dashboard_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_dashboard" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_sync"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_sync_icon"
                style="@style/BottomTabIcon"
                android:text="sync" />

            <TextView
                android:id="@+id/tab_sync_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_sync" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_setup"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_setup_icon"
                style="@style/BottomTabIcon"
                android:text="dashboard" />

            <TextView
                android:id="@+id/tab_setup_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_setup" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_categories"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_categories_icon"
                style="@style/BottomTabIcon"
                android:text="category" />

            <TextView
                android:id="@+id/tab_categories_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_categories" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_config"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_config_icon"
                style="@style/BottomTabIcon"
                android:text="settings" />

            <TextView
                android:id="@+id/tab_config_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_config" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_console"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_console_icon"
                style="@style/BottomTabIcon"
                android:text="terminal" />

            <TextView
                android:id="@+id/tab_console_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_console" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== App Lock overlay (full screen, dark) ===== -->
    <include
        android:id="@+id/app_lock_overlay"
        layout="@layout/view_app_lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
