<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ App-wide typography ============ -->
    <style name="AppText">
        <item name="android:textColor">@color/bubble_text_primary</item>
    </style>

    <style name="AppSectionTitle">
        <item name="android:textColor">@color/bubble_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppCaption">
        <item name="android:textColor">@color/bubble_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- ============ Material icon font renderers ============ -->
    <style name="IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/bubble_blue</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:fontFamily">@font/material_icons</item>
    </style>

    <style name="IconInline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/material_icons</item>
    </style>

    <style name="IconSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bubble_blue</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/material_icons</item>
    </style>

    <!-- ============ Bottom navigation ============ -->
    <style name="BottomTabItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="BottomTabIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/bubble_text_secondary</item>
        <item name="android:fontFamily">@font/material_icons</item>
    </style>

    <style name="BottomTabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bubble_text_secondary</item>
    </style>

    <!-- ============ Cards ============ -->
    <style name="BubbleCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="ChipStyle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ============ Inputs ============ -->
    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bubble_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BubbleEditText" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_card_12</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/bubble_text_primary</item>
        <item name="android:textColorHint">@color/bubble_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- ============ Terminal ============ -->
    <style name="TerminalText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
        <item name="android:textColor">@color/slate_400</item>
    </style>

</resources>
