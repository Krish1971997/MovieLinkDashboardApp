<?xml version="1.0" encoding="utf-8"?>
<!--
  Console tab (6th in bottom nav).
  Full-screen log terminal. Receives the Exact same log text the mini console
  on the Setup tab renders (SyncRunLog.snapshot(context)). The pages stay in
  sync because the logger writes every line into SharedPreferences.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_terminal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/IconSmall"
            android:text="terminal"
            android:textColor="@color/terminal_cyan"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scheduler Run Console"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/console_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/terminal_cyan"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Copy, Refresh + Clear controls -->
        <TextView
            android:id="@+id/console_copy"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_card_16"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Copy"
            android:textColor="@color/terminal_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/console_refresh"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card_16"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Refresh"
            android:textColor="@color/terminal_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/console_clear"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card_16"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Clear"
            android:textColor="@color/terminal_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Running Schedulers -->
    <LinearLayout
        android:id="@+id/running_schedulers_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/running_schedulers_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Running Schedulers (0)"
            android:textColor="@color/bubble_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/running_schedulers_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Log body -->
    <ScrollView
        android:id="@+id/console_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal_inner"
        android:fillViewport="true"
        android:padding="12dp">

        <TextView
            android:id="@+id/console_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4sp"
            android:textColor="@color/terminal_cyan"
            android:textSize="11sp" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Logs are produced by SyncScheduler, persisted in SharedPreferences under 'sync_run_log', and shared live with the Setup page's mini console."
        android:textColor="@color/bubble_text_secondary"
        android:textSize="9sp" />
</LinearLayout>