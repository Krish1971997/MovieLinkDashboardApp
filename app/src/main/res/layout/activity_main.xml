<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bubble_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== CenterAlignedTopAppBar ===== -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/bubble_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_card_12"
                android:padding="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/premium_movie_link_logo_1790163614766" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/title_brand"
                    android:textColor="@color/bubble_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/title_brand_sub"
                    android:textColor="@color/bubble_text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_help"
                style="@style/IconButton"
                android:text="help_outline" />

            <TextView
                android:id="@+id/btn_add"
                style="@style/IconButton"
                android:text="add_circle" />

            <TextView
                android:id="@+id/btn_options"
                style="@style/IconButton"
                android:text="more_vert"
                android:textColor="@color/bubble_text_secondary" />
        </LinearLayout>

        <!-- Secondary file import bar progress indicator -->
        <ProgressBar
            android:id="@+id/import_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/bubble_blue"
            android:visibility="gone" />

        <!-- ===== Tab content host ===== -->
        <FrameLayout
            android:id="@+id/content_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ===== Giant Blue Gradient Bottom Action Button (Dashboard tab only) ===== -->
    <FrameLayout
        android:id="@+id/bottom_action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="60dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bottom_action_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_gradient_button_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bottom_action_icon"
                style="@style/IconInline"
                android:text="cloud_upload" />

            <TextView
                android:id="@+id/bottom_action_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Import New Movie File"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Beautiful Bottom Tab Navigation Bar ===== -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_search"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_search_icon"
                style="@style/BottomTabIcon"
                android:text="search" />

            <TextView
                android:id="@+id/tab_search_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_search" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_sync"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_sync_icon"
                style="@style/BottomTabIcon"
                android:text="sync" />

            <TextView
                android:id="@+id/tab_sync_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_sync" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_dashboard"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_dashboard_icon"
                style="@style/BottomTabIcon"
                android:text="home" />

            <TextView
                android:id="@+id/tab_dashboard_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_dashboard" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_config"
            style="@style/BottomTabItem">

            <TextView
                android:id="@+id/tab_config_icon"
                style="@style/BottomTabIcon"
                android:text="settings" />

            <TextView
                android:id="@+id/tab_config_label"
                style="@style/BottomTabLabel"
                android:text="@string/tab_config" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== App Lock overlay (full screen, dark) ===== -->
    <include
        android:id="@+id/app_lock_overlay"
        layout="@layout/view_app_lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
